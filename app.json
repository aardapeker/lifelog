{
  "expo": {
    "name": "Lifelog",
    "slug": "lifelog",
    "scheme": [
      "lifelog",
      "dev.arda.lifelog"
    ],
    "version": "0.12.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "dev.arda.lifelog",
      "adaptiveIcon": {
        "backgroundColor": "#1D1C1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D1C1C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      [
        "expo-audio",
        {
          "microphonePermission": "Lifelog uses the microphone to turn your voice notes into journal entries."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lifelog uses the camera to add photos to your journal.",
          "photosPermission": "Lifelog lets you add photos from your gallery to your journal."
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D1C1C"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/libre-caslon-text/400Regular/LibreCaslonText_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "Lifelog",
              "label": "Lifelog",
              "description": "Talk or write to your journal in one tap",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/octet-stream"
          ],
          "disableIOS": true
        }
      ]
    ]
  }
}
